{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ForgeAI": "Server=localhost;Database=ForgeAI;Integrated Security=True;TrustServerCertificate=True;"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5050"
      }
    }
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_64_CHARACTERS",
    "Issuer": "ForgeAI",
    "ExpirationDays": 30
  },
  "App": {
    "BaseUrl": "http://localhost:5173"
  },
  "Auth": {
    "MagicLinkExpirationMinutes": 15
  },
  "Sharing": {
    "DefaultExpirationDays": 7
  },
  "Pipeline": {
    "IntervalMinutes": 10080,
    "EvaluationThresholds": {
      "RejectBelow": 40,
      "WatchBelow": 70,
      "PrototypeAbove": 70
    },
    "ClusterSignalThreshold": 3,
    "PrototypeTimeoutMinutes": 20,
    "PrototypesBasePath": "../prototypes",
    "ResearchBasePath": "../research",
    "ResearchTimeoutMinutes": 8,
    "DashboardPath": "../dashboard/dist",
    "DashboardUrl": "http://localhost:5173"
  },
  "ProductHunt": {
    "Token": "YOUR_PRODUCT_HUNT_API_TOKEN"
  },
  "SerpApi": {
    "ApiKey": "YOUR_SERPAPI_KEY"
  },
  "AWS": {
    "AccessKeyId": "YOUR_AWS_ACCESS_KEY_ID",
    "SecretAccessKey": "YOUR_AWS_SECRET_ACCESS_KEY",
    "Region": "us-east-2",
    "Bedrock": {
      "ModelId": "us.anthropic.claude-sonnet-5-5"
    },
    "SES": {
      "FromEmail": "noreply@example.com",
      "ToEmail": "admin@example.com"
    }
  }
}
